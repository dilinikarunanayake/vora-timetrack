# Copy this file to .env and fill in the values.
# .env is ignored by Git - never commit real secrets.

# Generate a key with:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=replace-me-with-a-generated-key

# True only on your own computer. Must be False when deployed.
DJANGO_DEBUG=True

DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Password given to the FICTIONAL demo users created by `python manage.py seed_demo`.
# Local development only. Choose your own (10+ characters).
DEMO_USER_PASSWORD=choose-a-local-demo-password
